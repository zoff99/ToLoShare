<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:contentInsetStart="0dp"
        android:contentInsetLeft="0dp"
        android:minHeight="?attr/actionBarSize"
        android:paddingLeft="0dp"
        app:contentInsetLeft="0dp"
        app:contentInsetStart="0dp"
        app:contentInsetStartWithNavigation="0dp"
        app:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_normal_main_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textOff="gallery view"
            android:textOn="main view"
            android:tooltipText="toogle map view"
            app:showText="false"
            tools:ignore="HardcodedText" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_friend_gps_smoothing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textOff="gallery view"
            android:textOn="main view"
            android:tooltipText="toogle friend GPS smoothing"
            app:showText="false"
            tools:ignore="HardcodedText" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_own_gps_smoothing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textOff="gallery view"
            android:textOn="main view"
            android:tooltipText="toogle own GPS smoothing"
            app:showText="false"
            tools:ignore="HardcodedText" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/button_travel_mode"
            android:layout_width="55dp"
            android:layout_margin="9dp"
            android:padding="2dp"
            android:layout_height="wrap_content"
            android:src="@drawable/outline_directions_car_24"
            android:scaleType="fitCenter"
            app:iconGravity="textStart" />

        <Spinner
            android:id="@+id/spinner_own_status"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:layout_marginLeft="0dp"
            android:paddingLeft="0dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="0dp"
            android:paddingLeft="0dp"
            android:text="@string/app_name"
            android:textColor="@android:color/primary_text_dark"
            android:textSize="18sp"
            android:visibility="gone"
            android:textStyle="bold" />
    </androidx.appcompat.widget.Toolbar>

    <!-- the layout which will contain (host) the drawerLayout -->
    <FrameLayout
        android:id="@+id/drawer_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/waiting_container"
                android:layout_width="match_parent"
                android:layout_weight="5"
                android:layout_height="match_parent"
                android:background="@color/md_white_1000"
                android:visibility="visible">

                <TextView
                    android:id="@+id/waiting_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginBottom="40dp"
                    android:background="@color/md_white_1000"
                    android:gravity="center"
                    android:text="@string/layout___waiting_for_orbot"
                    android:textSize="20sp"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/waiting_image"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="20dp"
                    android:indeterminate="true"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/normal_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:visibility="visible"
                    tools:context="com.zoffcc.applications.trifa.MainActivity">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <LinearLayout
                            android:id="@+id/icon_container"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/main_maintext"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingLeft="5dp"
                                android:paddingRight="5dp"
                                android:text="..."
                                android:textColor="@color/md_black_1000"
                                android:textSize="12sp"
                                android:visibility="visible"
                                tools:ignore="HardcodedText" />

                            <ImageView
                                android:id="@+id/main_maintopimage"
                                android:layout_width="70dp"
                                android:layout_height="match_parent"
                                android:layout_margin="0dp"
                                android:paddingLeft="5dp"
                                android:paddingTop="5dp"
                                android:paddingRight="5dp"
                                android:paddingBottom="0dp"
                                android:scaleType="fitStart"
                                android:src="@null"
                                android:visibility="gone" />

                            <ImageView
                                android:id="@+id/main_maintopimage2"
                                android:layout_width="70dp"
                                android:layout_height="match_parent"
                                android:layout_margin="0dp"
                                android:paddingLeft="5dp"
                                android:paddingTop="0dp"
                                android:paddingRight="5dp"
                                android:paddingBottom="0dp"
                                android:scaleType="fitStart"
                                android:src="@null"
                                android:visibility="gone" />

                            <ImageView
                                android:id="@+id/main_maintopimage3"
                                android:layout_width="70dp"
                                android:layout_height="match_parent"
                                android:layout_margin="0dp"
                                android:paddingLeft="5dp"
                                android:paddingTop="0dp"
                                android:paddingRight="5dp"
                                android:paddingBottom="0dp"
                                android:scaleType="fitStart"
                                android:src="@drawable/about_icon_github"
                                android:visibility="visible" />
                        </LinearLayout>

                    </RelativeLayout>

                    <fragment
                        android:id="@+id/fl_fragment"
                        android:name="com.zoffcc.applications.trifa.FriendListFragment"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        tools:layout="@layout/friend_list_layout" />

                </LinearLayout>

            </FrameLayout>


            <!-- left side with map -->
            <!-- left side with map -->
            <LinearLayout
                android:id="@+id/main_gallery_container"
                android:layout_weight="5"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical" >

                <!-- The 4 grey bars, wrapped so they can collapse -->
                <LinearLayout
                    android:id="@+id/top_hud_bars"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" >

                    <LinearLayout
                        android:layout_weight="5"
                        android:layout_marginTop="2dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/border_background"
                        android:orientation="horizontal" >

                        <RelativeLayout
                            android:layout_marginTop="0dp"
                            android:layout_marginBottom="0dp"
                            android:layout_weight="10"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical" >

                            <TextView
                                android:id="@+id/debug_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingLeft="5dp"
                                android:paddingRight="5dp"
                                android:text="...."
                                android:textColor="@color/md_black_1000"
                                android:textSize="10sp"
                                android:layout_alignParentTop="true"
                                android:visibility="visible"
                                tools:ignore="HardcodedText" />

                            <TextView
                                android:id="@+id/found_loc_providers_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingTop="0dp"
                                android:paddingLeft="5dp"
                                android:paddingRight="5dp"
                                android:text="passive, network, gps"
                                android:textColor="@color/md_black_1000"
                                android:textSize="9sp"
                                android:layout_alignParentBottom="true"
                                android:visibility="visible"
                                tools:ignore="HardcodedText" />
                        </RelativeLayout>

                        <TextView
                            android:id="@+id/self_speed_indicator"
                            android:layout_gravity="center"
                            android:layout_width="45dp"
                            android:layout_height="45dp"
                            android:padding="0dp"
                            android:layout_marginRight="6dp"
                            android:alpha="1.0"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="130"
                            android:textColor="#000000"
                            android:textSize="17sp"
                            android:visibility="invisible"
                            android:background="@drawable/circle_background"
                            tools:ignore="HardcodedText" />


                        <ImageButton
                            android:id="@+id/btn_follow_self"
                            android:layout_width="50dp"
                            android:layout_height="60dp"
                            android:cropToPadding="true"
                            android:padding="0dp"
                            android:layout_gravity="center_vertical"
                            android:layout_marginRight="6dp"
                            android:alpha="0.5"
                            android:tooltipText="follow own position on map"
                            android:background="@drawable/transparent"
                            android:scaleType="centerInside"
                            android:src="@drawable/outline_arrow_circle_right_24" />

                    </LinearLayout>
                    <LinearLayout
                        android:layout_weight="5"
                        android:layout_marginTop="2dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/border_background"
                        android:orientation="horizontal" >

                        <TextView
                            android:id="@+id/debug_text_2"
                            android:layout_width="0dp"
                            android:layout_weight="10"
                            android:layout_height="wrap_content"
                            android:paddingLeft="5dp"
                            android:paddingRight="5dp"
                            android:text="..."
                            android:textColor="@color/md_black_1000"
                            android:textSize="10sp"
                            android:visibility="visible"
                            tools:ignore="HardcodedText" />

                        <ImageButton
                            android:id="@+id/icon_speed_0"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:cropToPadding="true"
                            android:padding="0dp"
                            android:layout_marginRight="1dp"
                            android:layout_gravity="center"
                            android:alpha="0.5"
                            android:background="@drawable/transparent"
                            android:scaleType="fitCenter"
                            android:src="@null" />

                        <ImageButton
                            android:id="@+id/btn_route_to_friend_0"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:cropToPadding="true"
                            android:padding="0dp"
                            android:layout_marginRight="6dp"
                            android:alpha="0.5"
                            android:tooltipText="show route to friend"
                            android:background="@drawable/transparent"
                            android:scaleType="fitCenter"
                            android:src="@drawable/outline_assistant_navigation_24" />

                        <ImageButton
                            android:id="@+id/btn_follow_friend_0"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:cropToPadding="true"
                            android:padding="0dp"
                            android:layout_marginRight="6dp"
                            android:alpha="0.5"
                            android:tooltipText="follow this friends positon on map"
                            android:background="@drawable/transparent"
                            android:scaleType="centerInside"
                            android:src="@drawable/outline_arrow_circle_right_24" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_weight="5"
                        android:layout_marginTop="2dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/border_background"
                        android:orientation="horizontal" >

                        <TextView
                            android:id="@+id/debug_text_3"
                            android:layout_width="0dp"
                            android:layout_weight="10"
                            android:layout_height="wrap_content"
                            android:paddingLeft="5dp"
                            android:paddingRight="5dp"
                            android:text="..."
                            android:textColor="@color/md_black_1000"
                            android:textSize="10sp"
                            android:visibility="visible"
                            tools:ignore="HardcodedText" />

                        <ImageButton
                            android:id="@+id/icon_speed_1"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:cropToPadding="true"
                            android:padding="0dp"
                            android:layout_marginRight="1dp"
                            android:layout_gravity="center"
                            android:alpha="0.5"
                            android:background="@drawable/transparent"
                            android:scaleType="fitCenter"
                            android:src="@null" />

                        <ImageButton
                            android:id="@+id/btn_route_to_friend_1"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:cropToPadding="true"
                            android:padding="0dp"
                            android:layout_marginRight="6dp"
                            android:alpha="0.5"
                            android:tooltipText="show route to friend"
                            android:background="@drawable/transparent"
                            android:scaleType="fitCenter"
                            android:src="@drawable/outline_assistant_navigation_24" />

                        <ImageButton
                            android:id="@+id/btn_follow_friend_1"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:cropToPadding="true"
                            android:padding="0dp"
                            android:layout_marginRight="6dp"
                            android:alpha="0.5"
                            android:tooltipText="follow this friends positon on map"
                            android:background="@drawable/transparent"
                            android:scaleType="centerInside"
                            android:src="@drawable/outline_arrow_circle_right_24" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="2dp"
                        android:layout_weight="5"
                        android:background="@drawable/border_background"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/debug_text_info"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="10"
                            android:paddingLeft="5dp"
                            android:paddingRight="5dp"
                            android:text="elrtel tmlrtkler toerot jioertioj iotje"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:visibility="visible"
                            tools:ignore="HardcodedText" />

                        <com.zoffcc.applications.trifa.TriangleTextView
                            android:id="@+id/online_count"
                            android:layout_width="25dp"
                            android:layout_height="50dp"
                            android:layout_marginRight="0dp"
                            android:padding="0dp"
                            android:scaleType="fitCenter" />

                        <com.zoffcc.applications.trifa.TriangleTextView
                            android:id="@+id/out_count"
                            android:layout_width="25dp"
                            android:layout_height="50dp"
                            android:layout_marginRight="0dp"
                            android:padding="0dp"
                            android:scaleType="fitCenter" />

                        <com.zoffcc.applications.trifa.TriangleTextView
                            android:id="@+id/in_count"
                            android:layout_width="25dp"
                            android:layout_height="50dp"
                            android:layout_marginRight="6dp"
                            android:padding="0dp"
                            android:scaleType="fitCenter" />

                        <ImageButton
                            android:id="@+id/btn_follow_stop"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:layout_marginRight="6dp"
                            android:alpha="0.5"
                            android:background="@drawable/transparent"
                            android:cropToPadding="true"
                            android:padding="0dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/outline_cancel_24"
                            android:tooltipText="unpin map, do not follow anyone and clear all routes" />

                    </LinearLayout>

                </LinearLayout>

                <FrameLayout
                    android:id="@+id/main_gallery_container_inside"
                    android:layout_weight="5"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <org.osmdroid.views.MapView android:id="@+id/map"
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent" />

                    <!-- Add the SeekBar here, inside the FrameLayout -->
                    <SeekBar
                        android:id="@+id/trail_playback_seekbar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_marginLeft="40dp"
                        android:layout_marginRight="30dp"
                        android:layout_marginBottom="32dp"
                        android:max="1000"
                        android:progress="1000" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|right"
                        android:layout_marginRight="16dp"
                        android:layout_marginBottom="80dp"
                        android:orientation="vertical">

                        <ImageButton
                            android:id="@+id/map_zoom_in"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@android:color/white"
                            android:src="@drawable/zoom_in"
                            android:scaleType="centerInside"
                            android:visibility="gone"
                            android:contentDescription="Zoom In" />

                        <ImageButton
                            android:id="@+id/map_zoom_out"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginTop="8dp"
                            android:background="@android:color/white"
                            android:src="@drawable/zoom_out"
                            android:scaleType="centerInside"
                            android:visibility="gone"
                            android:contentDescription="Zoom Out" />

                    </LinearLayout>

                    <!-- Modern pull-handle: OVERLAYS the map at the top, semi-transparent background -->
                    <RelativeLayout
                        android:id="@+id/hud_handle"
                        android:layout_width="match_parent"
                        android:layout_height="20dp"
                        android:layout_gravity="top"
                        android:background="#99F5F5F5"
                        android:clickable="true"
                        android:focusable="true"
                        android:tooltipText="show / hide map info panel">

                        <!-- Chevron: perfectly centered horizontally and vertically -->
                        <View
                            android:id="@+id/hud_handle_chevron"
                            android:layout_width="40dp"
                            android:layout_height="4dp"
                            android:layout_centerInParent="true"
                            android:background="@drawable/hud_grabber" />

                        <!-- Circles container: pinned to right edge, vertically centered -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_alignParentEnd="true"
                            android:layout_marginEnd="8dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:id="@+id/hud_circle_1"
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:background="@drawable/hud_status_circle_green" />

                            <View
                                android:id="@+id/hud_circle_2"
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_marginStart="10dp"
                                android:background="@drawable/hud_status_circle_yellow" />

                            <View
                                android:id="@+id/hud_circle_3"
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_marginStart="10dp"
                                android:background="@drawable/hud_status_circle_red" />

                        </LinearLayout>

                    </RelativeLayout>

                    <LinearLayout
                        android:id="@+id/low_battery_warning_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|center_horizontal"
                        android:layout_marginTop="24dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/icon_low_battery_warning"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:src="@android:drawable/ic_dialog_alert"
                            android:tint="#FF0000" />

                        <TextView
                            android:id="@+id/text_low_battery_warning"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Battery Low!\nApp Halted"
                            android:textColor="#FF0000"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:gravity="center"
                            android:shadowColor="#000000"
                            android:shadowDx="2"
                            android:shadowDy="2"
                            android:shadowRadius="2"
                            android:layout_marginTop="4dp" />

                    </LinearLayout>

                </FrameLayout>

            </LinearLayout>
            <!-- left side with map -->
            <!-- left side with map -->

        </LinearLayout>

    </FrameLayout>
</RelativeLayout>


